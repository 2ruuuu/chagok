#!/bin/sh
# 커밋 전에 스테이징된 파일만 Biome으로 자동 수정 (포맷 · import 정렬 · 안전한 lint 수정)
# - 고친 내용은 같은 커밋에 다시 담음 (git update-index --again)
# - 자동으로 못 고치는 lint 에러가 남으면 커밋을 막음 -> 에러 고치고 다시 커밋
# - 급하게 건너뛰려면 git commit --no-verify
# 설치: npm install 때 prepare 스크립트가 git config core.hooksPath .githooks 를 실행

npx biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true --colors=off || {
  echo ""
  echo "Biome이 자동으로 못 고친 에러가 있어서 커밋을 멈췄어요. 위 에러를 고치고 다시 커밋해 주세요."
  exit 1
}

git update-index --again
